{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jailbreak Changelogs",
  "mainBinaryName": "jailbreak-changelogs",
  "version": "../package.json",
  "identifier": "com.jailbreakchangelogs.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/tauri",
    "beforeDevCommand": "node build/make-ocr-pack.mjs && npm run tauri:vite",
    "beforeBuildCommand": "node build/make-ocr-pack.mjs && npm run tauri:vite:build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "shortDescription": "Jailbreak Changelogs desktop app",
    "longDescription": "Values, trading, trackers and messages for Roblox Jailbreak, from Jailbreak Changelogs.",
    "createUpdaterArtifacts": true,
    "publisher": "Jailbreak Changelogs",
    "category": "SocialNetworking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "icon.ico",
      "icons/icon.png": "icon.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "template": "nsis/installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "desktopTemplate": "linux/jailbreak-changelogs.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/jailbreak-changelogs.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "jailbreakchangelogs"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRDUwMTg1MjlDMTVBQjAKUldTd1dzRXBoUUhWckgzQ1AvNk1HdnhEZnU2TFYzdzZDclJTK0IvalBpcjNsRjQwaTBVM2dldGkK",
      "endpoints": [
        "https://updates.jailbreakchangelogs.com/tauri/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}